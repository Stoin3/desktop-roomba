[Desktop Entry]
Type=Application
Name=KDE Roomba
GenericName=Bureaublad-stofzuiger
Comment=Een roomba die afval van je bureaublad opruimt met een lokaal AI-model
Exec=@BIN@/kde-roomba
Icon=edit-clear-all
Terminal=false
Categories=Utility;
StartupNotify=false
X-KDE-autostart-after=panel
X-KDE-AutostartPhase=2
X-GNOME-Autostart-enabled=true
Actions=Restart;Quit;

[Desktop Action Restart]
Name=Herstarten
Icon=view-refresh
Exec=@BIN@/kde-roomba --restart

[Desktop Action Quit]
Name=Afsluiten
Icon=application-exit
Exec=@BIN@/kde-roomba --quit
